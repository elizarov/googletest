# See external/strictfmt/docs/format.md for details
---
ColumnLimit: 120
IndentWidth: 2
TabWidth: 2

MacroCategories:
  DeclarationModifierMacros:
    - GTEST_API_
    - GTEST_ATTRIBUTE_*
    - GTEST_INTERNAL_DEPRECATE_AND_INLINE
    - GTEST_NO_INLINE_
    - GTEST_NO_TAIL_CALL_
    - WINAPI
  MethodDeclarationMacros:
    - MOCK_METHOD
  ItemMacros:
    - GTEST_INTENTIONAL_CONST_COND_*
