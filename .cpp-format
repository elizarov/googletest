# See external/strictfmt/docs/format.md for details
---
ColumnLimit: 120
IndentWidth: 2
TabWidth: 2

MacroCategories:
  BareIdentifierMacros:
    - GTEST_API_
    - GTEST_ATTRIBUTE_*
    - GTEST_DECLARE_*
    - GTEST_DEFINE_*
    - GTEST_EXCLUSIVE_LOCK_REQUIRED_
    - GTEST_FLAT_TUPLE_INT*
    - GTEST_INTERNAL_DEPRECATE_AND_INLINE
    - GTEST_LOCK_EXCLUDED_
    - GTEST_NO_INLINE_
    - GTEST_NO_TAIL_CALL_
    - GTEST_REFERENCE_TO_CONST_
    - GTEST_TEST_THROW_
    - GTEST_TEST_NO_THROW_
    - GTEST_TEST_ANY_THROW_
    - INSTANTIATE_TEST_SUITE_P
    - LEGACY_MY_MOCK_METHODS*
    - MY_MOCK_METHODS*
    - WINAPI
  DeclarationPrefixMacros:
    - GTEST_API_
    - GTEST_ATTRIBUTE_*
    - GTEST_INTERNAL_DEPRECATE_AND_INLINE
    - GTEST_INTERNAL_EMPTY_BASE_CLASS
    - GTEST_NO_INLINE_
    - GTEST_NO_TAIL_CALL_
    - WINAPI
  CallSyntaxMacros:
    - ACTION
    - ACTION_P*
    - ACTION_TEMPLATE
    - FRIEND_TEST
    - GMOCK_DECLARE_*
    - GMOCK_DEFINE_DEFAULT_ACTION_FOR_RETURN_TYPE_
    - GMOCK_DEFINE_*
    - GMOCK_KIND_OF_
    - GMOCK_PP_*
    - GTEST_CHECK_POSIX_SUCCESS_
    - GTEST_DECLARE_*
    - GTEST_DEFINE_*
    - GTEST_IMPL_FORMAT_C_STRING_AS_POINTER_
    - GTEST_IMPL_FORMAT_C_STRING_AS_STRING_
    - GTEST_ASSERT_*
    - GTEST_ALLOW_UNINSTANTIATED_PARAMETERIZED_TEST
    - GTEST_TEST
    - GTEST_REPEATER_METHOD_
    - GTEST_REVERSE_REPEATER_METHOD_
    - GTEST_SUPPRESS_UNREACHABLE_CODE_WARNING_BELOW_
    - GTEST_TEST_CLASS_NAME_
    - INSTANTIATE_TEST_SUITE_P
    - INSTANTIATE_TEST_CASE_P
    - INSTANTIATE_TYPED_TEST_SUITE_P
    - INSTANTIATE_GTEST_MATCHER_TEST_P
    - MATCHER
    - MATCHER_P*
    - MOCK_CONST_METHOD*
    - MOCK_CONST_METHOD_T*
    - MOCK_CONST_METHOD_WITH_CALLTYPE*
    - MOCK_METHOD*
    - MOCK_METHOD_T*
    - MOCK_METHOD_WITH_CALLTYPE*
    - REGISTER_TYPED_TEST_SUITE_P
    - TEST
    - TEST_F
    - TEST_P
    - TYPED_TEST
    - TYPED_TEST_P
    - TYPED_TEST_SUITE
    - TYPED_TEST_SUITE_P
  SemicolonlessCallMacros:
    - GMOCK_INTERNAL_PARSE_FLAG
    - GTEST_DISABLE_DEPRECATED_*
    - GTEST_DISABLE_MSC_WARNINGS_*
    - GTEST_IMPL_CMP_HELPER_
    - GTEST_INTENTIONAL_CONST_COND_*
    - THOUSAND_TESTS_
  TypeSpecifierMacros:
    - GTEST_BIND_
    - GTEST_REMOVE_REFERENCE_AND_CONST_
  PreprocessorArgumentMacros:
    - EXPECT_EXPANSION
    - GMOCK_PP_FOR_EACH
    - GMOCK_PP_HAS_COMMA
    - GMOCK_PP_IS_BEGIN_PARENS
    - GMOCK_PP_IS_EMPTY
    - GMOCK_PP_IS_ENCLOSED_PARENS
  StatementArgumentMacros:
    - ASSERT_ANY_THROW
    - ASSERT_DEATH
    - ASSERT_DEBUG_DEATH
    - ASSERT_DEATH_IF_SUPPORTED
    - ASSERT_EXIT
    - ASSERT_NO_FATAL_FAILURE
    - ASSERT_NO_THROW
    - ASSERT_THROW
    - EXPECT_ANY_THROW
    - EXPECT_DEBUG_DEATH
    - EXPECT_DEATH
    - EXPECT_DEATH_IF_SUPPORTED
    - EXPECT_EXIT
    - EXPECT_FATAL_FAILURE
    - EXPECT_FATAL_FAILURE_ON_ALL_THREADS
    - EXPECT_NO_FATAL_FAILURE
    - EXPECT_NO_THROW
    - EXPECT_NONFATAL_FAILURE
    - EXPECT_NONFATAL_FAILURE_ON_ALL_THREADS
    - EXPECT_THROW
